<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App2_Chat.SettingsPage"
             Title="Configuración"
             BackgroundColor="#F0F0F0">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- Título -->
            <Label Text="Configuración del Sistema" 
                   FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#333"/>

            <!-- Sección Broker RabbitMQ -->
            <Frame BorderColor="Gray" CornerRadius="10" Padding="15" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Config Broker (RabbitMQ)" FontAttributes="Bold" TextColor="#007ACC"/>

                    <Label Text="IP Broker:" FontSize="12"/>
                    <Entry x:Name="EntIpBroker" Text="localhost" Placeholder="ej: 192.168.1.100"/>

                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Column="0" Margin="0,0,5,0">
                            <Label Text="Cola Publicar:" FontSize="12"/>
                            <Entry x:Name="EntColaPublish" Text="cola1"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Margin="5,0,0,0">
                            <Label Text="Cola Consumir:" FontSize="12"/>
                            <Entry x:Name="EntColaConsume" Text="cola2"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Sección LLM (LM Studio) -->
            <Frame BorderColor="Gray" CornerRadius="10" Padding="15" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Config LLM (LM Studio)" FontAttributes="Bold" TextColor="#28A745"/>

                    <Label Text="URI API:" FontSize="12"/>
                    <Entry x:Name="EntLlmUrl" Text="http://localhost:1234/v1/chat/completions"/>

                    <Label Text="Modelo:" FontSize="12"/>
                    <Entry x:Name="EntModel" Text="llama-3.2-1b-instruct" Placeholder="Nombre del modelo en LM Studio"/>

                    <Label Text="System Prompt (Rol):" FontSize="12"/>
                    <Editor x:Name="EdSystemPrompt" Text="Eres un asistente útil y breve." HeightRequest="80" BackgroundColor="#FAFAFA"/>

                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Column="0" Margin="0,0,5,0">
                            <Label Text="Temperatura:" FontSize="12"/>
                            <Entry x:Name="EntTemp" Text="0.7" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Margin="5,0,0,0">
                            <Label Text="Max Tokens:" FontSize="12"/>
                            <Entry x:Name="EntTokens" Text="150" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Botones -->
            <Button Text="Guardar y Volver" 
                    Clicked="OnSaveClicked"
                    BackgroundColor="#007ACC" 
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="50"
                    Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
